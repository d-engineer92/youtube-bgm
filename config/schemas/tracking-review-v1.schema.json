          "interval": {
            "$ref": "#/$defs/interval"
          },
          "observations": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/observation"
            }
          },
          "first_seen_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "tracking_state": {
            "type": [
              "string",
              "null"
            ]
          },
          "tracking_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "next_due_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "subject_kind": {
            "const": "video"
          },
          "channel_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "target_id",
          "video_id",
          "ownership",
          "interval",
          "observations",
          "first_seen_at",
          "tracking_state",
          "tracking_reason",
          "next_due_at",
          "subject_kind",
          "channel_id"
