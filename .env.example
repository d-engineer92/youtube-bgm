APP_NAME="YouTube BGM Research"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8088
APP_LOCALE=ja
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=youtube_bgm
DB_USERNAME=bgm
DB_PASSWORD=local-bgm-only
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
LOG_CHANNEL=daily
LOG_DAILY_DAYS=7
QUEUE_CONNECTION=database

# live: 実API。キーがない場合は失敗として表示し、デモへ切り替えない。
# demo: 架空データ。実データとはsource列で分離する。
YOUTUBE_MODE=live
YOUTUBE_API_KEY=
YOUTUBE_INITIAL_LIMIT=20
YOUTUBE_MAX_ITEMS=200
YOUTUBE_TIMEOUT=10
YOUTUBE_RETRIES=1
YOUTUBE_MAX_CALLS_PER_OPERATION=20
YOUTUBE_OPERATION_SECONDS=60
# このアプリの呼出回数上限。Google Cloudの割当を保証する値ではない。
# リトライも数える。日付の切替はAmerica/Los_Angeles。
YOUTUBE_DAILY_SEARCH_CALLS=20
YOUTUBE_DAILY_READ_CALLS=500
